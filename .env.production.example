APP_NAME="LAKMUD Penilaian"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lakmud_penilaian
DB_USERNAME=lakmud_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=lakmud_penilaian_cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun operator pertama yang dibuat `php artisan db:seed --force`. Langkah lengkapnya ada di
# docs/deployment-production.md §4. OPERATOR_PASSWORD wajib diisi sebelum seeding: kalau kosong,
# seeder berhenti dengan pesan yang jelas alih-alih membuat akun berkata sandi acak yang tidak bisa
# dipakai login. Isi OPERATOR_EMAIL dengan alamat asli, bukan alamat contoh.
OPERATOR_EMAIL=operator@domain-anda.example
OPERATOR_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
